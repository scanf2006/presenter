{
  "appId": "com.aiden.churchdisplaypro.zh",
  "productName": "churchdisplay-pro-zh",
  "artifactName": "${productName} Setup ${version}.${ext}",
  "files": [
    "electron/**/*",
    "shared/**/*",
    "dist/**/*",
    "package.json",
    "LICENSE",
    "EULA.md"
  ],
  "asarUnpack": ["electron/ppt-convert.ps1"],
  "extraResources": [
      {
        "from": "data",
        "to": "data",
        "filter": [
          "bible_*.db"
        ]
      },
      {
        "from": "vendor/youtube-runtime",
        "to": "youtube-runtime"
      }
  ],
  "win": {
    "target": [
      "nsis"
    ]
  },
  "nsis": {
    "oneClick": false,
    "allowToChangeInstallationDirectory": true
  }
}
