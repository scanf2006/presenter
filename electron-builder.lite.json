{
  "appId": "com.aiden.churchdisplaypro",
  "productName": "churchdisplay-pro",
  "files": [
    "electron/**/*",
    "shared/**/*",
    "dist/**/*",
    "!dist/win-unpacked{,/**}",
    "!dist/*.exe",
    "!dist/*.blockmap",
    "!dist/*.zip",
    "!dist/__*",
    "package.json",
    "LICENSE",
    "EULA.md"
  ],
  "asarUnpack": ["electron/ppt-convert.ps1"],
  "extraResources": [
      {
        "from": "data",
        "to": "data",
        "filter": [
          "bible_*.db"
        ]
      },
      {
        "from": "vendor/youtube-runtime",
        "to": "youtube-runtime"
      }
  ],
  "win": {
    "target": [
      "nsis"
    ]
  },
  "nsis": {
    "oneClick": false,
    "allowToChangeInstallationDirectory": true
  }
}
