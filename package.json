{
  "name": "churchdisplay-pro",
  "version": "0.3.209",
  "description": "ChurchDisplay Pro - Worship projection system",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test \"tests/**/*.test.js\"",
    "i18n:check": "node scripts/check-i18n-encoding.js",
    "build:zh:check": "node scripts/check-zh-build-artifact.js",
    "commercial:gate": "node scripts/commercial-gate.js",
    "lint": "eslint \"src/**/*.{js,jsx}\"",
    "format": "prettier --write .",
    "runtime:prepare": "powershell -ExecutionPolicy Bypass -File scripts/prepare-youtube-runtime.ps1",
    "tauri:check": "set PATH=%USERPROFILE%\\.cargo\\bin;%PATH%&& cargo check --manifest-path src-tauri/Cargo.toml",
    "tauri:dev": "set PATH=%USERPROFILE%\\.cargo\\bin;%PATH%&& tauri dev",
    "tauri:build": "npm run runtime:prepare && tauri build --bundles nsis",
    "tauri:build:zh": "npm run runtime:prepare && set VITE_APP_LOCALE=zh-CN&& tauri build --bundles nsis",
    "license:generate": "node scripts/generate-license.js",
    "diagnostics:incident-bundle": "node scripts/incident-bundle.js"
  },
  "dependencies": {
    "@fontsource/long-cang": "^5.2.8",
    "@fontsource/lxgw-wenkai-mono-tc": "^5.2.9",
    "@fontsource/lxgw-wenkai-tc": "^5.2.9",
    "@fontsource/ma-shan-zheng": "^5.2.9",
    "@fontsource/noto-sans-sc": "^5.2.9",
    "@fontsource/noto-serif-sc": "^5.2.9",
    "@fontsource/zcool-kuaile": "^5.2.8",
    "@fontsource/zcool-qingke-huangyou": "^5.2.8",
    "@fontsource/zcool-xiaowei": "^5.2.8",
    "@fontsource/zhi-mang-xing": "^5.2.8",
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-dialog": "^2.7.3"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.11.4",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^8.57.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "pdfjs-dist": "^5.6.205",
    "prettier": "^3.5.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "vite": "^6.0.3"
  }
}
